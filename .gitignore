# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform variable files (may contain secrets)
*.tfvars
*.tfvars.json

# Terraform crash logs
crash.log
crash.*.log

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration and credentials
.terraformrc
terraform.rc

# Environment files and secrets
.env
.env.*
!.env.example

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local AWS credentials
accesskey.txt
*accesskey*
.aws/

